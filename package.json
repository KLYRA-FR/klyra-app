{
  "name": "klyra-app",
  "version": "0.1.0",
  "private": true,
  "description": "App de bureau interne KLYRA : chat avec des rôles (Principal, Dev, UX/UI, DA), projets et fichiers.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev -p 3100",
    "postinstall": "node scripts/nom-app-dev.mjs",
    "desktop": "pnpm build:electron && concurrently -k -n web,app -c gray,black \"next dev -p 3100\" \"wait-on http://localhost:3100 && env -u ELECTRON_RUN_AS_NODE KLYRA_DEV_URL=http://localhost:3100 electron .\"",
    "build": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "agents:equipe": "node scripts/agents-equipe.mjs",
    "start:desktop": "pnpm build && pnpm build:electron && env -u ELECTRON_RUN_AS_NODE electron .",
    "test:smoke": "pnpm build && pnpm build:electron && env -u ELECTRON_RUN_AS_NODE KLYRA_SMOKE_TEST=1 electron .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test:agents": "pnpm build:electron && node scripts/test-agents.mjs",
    "test:consommation": "electron scripts/test-consommation.cjs",
    "app": "pnpm build && pnpm build:electron && pnpm whisper && electron-builder --mac --publish never --config.directories.output=\"$HOME/.klyra/build\"",
    "whisper": "node scripts/preparer-whisper.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "klyra-ui": "github:CorentinQueuche/klyra-ui#main",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.9.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "packageManager": "pnpm@11.0.4",
  "build": {
    "appId": "design.klyra.app",
    "productName": "KLYRA",
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "asarUnpack": [
      "resources/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "sign": "scripts/signer-mac.cjs",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KLYRA utilise le micro pour la dictée, transcrite sur ce Mac."
      },
      "extraResources": [
        {
          "from": "vendor/whisper/darwin",
          "to": "whisper",
          "filter": [
            "whisper-cli"
          ]
        }
      ]
    },
    "dmg": {
      "title": "KLYRA"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "extraResources": [
        {
          "from": "vendor/whisper/win32",
          "to": "whisper",
          "filter": [
            "*.exe",
            "*.dll"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "KLYRA-${version}-win-x64-setup.exe",
      "shortcutName": "KLYRA"
    }
  }
}
