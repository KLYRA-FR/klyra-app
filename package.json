{
  "name": "klyra-app",
  "version": "0.1.0",
  "private": true,
  "description": "App de bureau interne KLYRA : chat avec des rôles (Principal, Dev, UX/UI, DA), projets et fichiers.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:convex": "convex dev",
    "postinstall": "node scripts/nom-app-dev.mjs",
    "desktop": "pnpm build:electron && concurrently -k -n web,app -c gray,black \"next dev -p 3100\" \"wait-on http://localhost:3100 && env -u ELECTRON_RUN_AS_NODE KLYRA_DEV_URL=http://localhost:3100 electron .\"",
    "build": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "site:dev": "next dev site -p 3200",
    "site:build": "next build site",
    "agents:equipe": "node scripts/agents-equipe.mjs",
    "start:desktop": "pnpm build && pnpm build:electron && env -u ELECTRON_RUN_AS_NODE electron .",
    "test:smoke": "pnpm build && pnpm build:electron && env -u ELECTRON_RUN_AS_NODE KLYRA_SMOKE_TEST=1 electron .",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache && node scripts/serveur-genere.mjs --verifier",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test:agents": "node scripts/test-agents.mjs",
    "test:onboarding": "node --experimental-strip-types --test electron/prise-en-main.test.mts && node scripts/test-prise-en-main.mjs && node scripts/test-mode-onboarding.mjs && node scripts/test-visite-guidee.mjs",
    "test:visite": "node scripts/test-visite-guidee.mjs",
    "test:superagent": "vitest run src/lib/liberer-place-fil.test.ts && pnpm build:electron && node scripts/test-superagent.cjs",
    "test:composio": "node scripts/test-composio-api.cjs && node scripts/test-composio-espace.cjs && node scripts/test-composio-connect.cjs && node scripts/test-composio-relais.cjs",
    "test:composio:natif": "electron scripts/test-composio-natif.cjs",
    "test:composio:runtime": "electron scripts/test-composio-runtime.cjs",
    "test:composio:interface": "electron scripts/test-composio-interface.cjs",
    "test:delegation": "node scripts/test-delegation.mjs",
    "test:maj-modeles": "node scripts/test-maj-modeles.mjs",
    "test:maj": "node --experimental-strip-types --test electron/maj-depot.test.mts",
    "test:bibliotheque": "node scripts/test-bibliotheque.mjs",
    "test:partage-artefact": "node scripts/test-partage-artefact.mjs",
    "test:conversation": "node scripts/test-conversation.mjs",
    "test:cerveau": "node --experimental-sqlite --experimental-strip-types --import ./scripts/resoudre-ts.mjs --test electron/cerveau.test.mts electron/cerveau-dossiers.test.mts electron/cerveau-liens.test.mts electron/extraction-fichiers.test.mts electron/cerveau-synchro.test.mts && node --experimental-sqlite --test serveur/cerveau.test.mjs",
    "bench:cerveau": "node --experimental-sqlite scripts/bench-cerveau.mjs",
    "test:graphe": "vitest run src/lib/graphe-memoire.test.ts src/lib/graphe-physique.test.ts && node --experimental-sqlite --experimental-strip-types --import ./scripts/resoudre-ts.mjs --test electron/graphe-souvenirs.test.mts electron/graphe-entretien.test.mts electron/graphe-agent.test.mts",
    "test:graphe:app": "node scripts/test-graphe-memoire.mjs",
    "test:memoire": "vitest run src/lib/memoire.test.ts && node scripts/test-memoire.mjs",
    "test:epinglage": "vitest run src/lib/epinglage.test.ts",
    "test:epingler": "node scripts/test-epinglage.mjs",
    "test:menu-contextuel": "node scripts/test-menu-contextuel.mjs",
    "test:export-document": "vitest run src/lib/export-conversation.test.ts",
    "test:exporter": "node scripts/test-export.mjs",
    "test:apercu": "vitest run src/lib/apercu/apercu.test.ts",
    "test:lecteurs": "node scripts/test-lecteurs.cjs",
    "test:visionneuse": "node scripts/test-visionneuse.mjs",
    "test:coller": "node scripts/test-collage.mjs",
    "test:chercher": "node scripts/test-recherche.mjs",
    "test:reporter": "node scripts/test-report.mjs",
    "test:annuler": "node scripts/test-annulation.mjs",
    "test:suppression": "vitest run src/lib/suppression-rappels.test.ts",
    "test:tickets": "vitest run src/lib/tickets.test.ts",
    "test:tickets:app": "node scripts/test-tickets.mjs",
    "test:profil": "node scripts/test-profil.mjs",
    "test:liens": "node scripts/test-liens.mjs",
    "test:jetons-compte": "electron scripts/test-jetons-compte.cjs",
    "test:session-maj": "node scripts/test-session-maj.mjs",
    "test:consommation": "electron scripts/test-consommation.cjs",
    "test:relais": "node --experimental-strip-types --test electron/ordinateur/relais.test.mts",
    "test:apercu-fenetre": "node --experimental-strip-types --test electron/ordinateur/apercu-cible.test.mts electron/ordinateur/navigateur-defaut.test.mts",
    "test:routines": "node scripts/test-routine-schedule.cjs && node scripts/test-routines.cjs && node scripts/test-routine-ipc.cjs && node scripts/test-routine-claude.cjs",
    "test:ordinateur": "electron scripts/test-ordinateur.cjs",
    "test:coffre": "node --experimental-strip-types --test electron/coffre-regles.test.mts && electron scripts/test-coffre.cjs",
    "test:coffre-ecran": "node scripts/test-coffre-ecran.mjs",
    "test:navigateur": "node --experimental-strip-types --test electron/navigateur/regles.test.mts electron/navigateur/identite.test.mts electron/navigateur/chrome-regles.test.mts && electron scripts/test-navigateur.cjs",
    "test:navigateur-chrome": "electron scripts/test-navigateur-chrome.cjs",
    "test:navigateur-ecran": "node scripts/test-navigateur-ecran.mjs",
    "test:sons": "electron scripts/test-sons.cjs",
    "app": "pnpm build && pnpm build:electron && pnpm whisper && pnpm cua-driver && pnpm github:preparer && electron-builder --mac --publish never --config.directories.output=\"$HOME/.klyra/build\"",
    "whisper": "node scripts/preparer-whisper.mjs",
    "cua-driver": "node scripts/preparer-cua-driver.mjs",
    "test:convex": "vitest run convex",
    "test:document-isole": "node --experimental-strip-types --test electron/document-isole.test.mts",
    "test:selecteur": "node scripts/test-selecteur-serveur.mjs",
    "test:equipe-par-serveur": "node scripts/test-equipe-par-serveur.mjs",
    "test:espace-serveur": "node scripts/test-espace-serveur.mjs",
    "test:mobile": "vitest run src/lib/mobile.test.ts src/lib/poste-texte.test.ts convex/telephone.test.ts && node --test serveur/qr.test.mjs",
    "test:reglages-mobile": "node scripts/test-mobile.mjs",
    "test:telephone-agents": "vitest run src/lib/telephone",
    "test:coque": "vitest run src/lib/coque.test.ts src/lib/push.test.ts convex/notificationsPush.test.ts",
    "test:joints-vps": "node --experimental-strip-types --test electron/joints-vps.test.mts && electron scripts/test-joints-vps.cjs",
    "test:serveur": "vitest run src/lib/serveur-vps.test.ts src/components/serveur/AvisMiseAJour.test.tsx && node scripts/serveur-genere.mjs --verifier && node --test scripts/empreinte-serveur.test.mjs serveur/klyra-serveur.test.mjs serveur/routines.test.mjs serveur/qr.test.mjs serveur/navigateur.test.mjs serveur/workflows.test.mjs serveur/fils.test.mjs serveur/workflows-moteur.test.mjs serveur/coffre.test.mjs serveur/atelier.test.mjs serveur/codex.test.mjs serveur/comptes-claude.test.mjs serveur/terminal.test.mjs serveur/mcp-sante.test.mjs && node scripts/test-serveur-grok.mjs && node --experimental-strip-types --test electron/lien-rejoindre.test.mts electron/appel-serveur.test.mts electron/contexte-distant.test.mts electron/atelier.test.mts electron/joints-vps.test.mts electron/terminal.test.mts electron/mcp-sante.test.mts",
    "test:binaire": "node --experimental-strip-types --test electron/claude-binaire.test.mts electron/artefacts-liste.test.mts",
    "test:mcp-oauth": "node --experimental-strip-types --test electron/mcp-oauth.test.mts",
    "test:mcp-poste": "node --experimental-strip-types --test electron/mcp-poste.test.mts",
    "test:titre": "node --experimental-strip-types --test electron/titre.test.mts",
    "test:diagnostic-poste": "node --experimental-strip-types --test electron/diagnostic-poste.test.mts",
    "test:connaissances": "node --experimental-strip-types --import ./scripts/resoudre-ts.mjs --test electron/connaissances-agent.test.mts electron/consommation-ecart.test.mts",
    "test:skills": "node --experimental-strip-types --import ./scripts/resoudre-ts.mjs --no-warnings scripts/test-skills.mjs",
    "test:skills-par-agent": "node --experimental-strip-types --import ./scripts/resoudre-ts.mjs --test electron/skills-par-agent.test.mts",
    "test:preparation": "node --experimental-strip-types --import ./scripts/resoudre-ts.mjs --test electron/preparation-fournisseur.test.mts",
    "test:comptes-claude": "node --experimental-strip-types --test electron/comptes-claude.test.mts serveur/comptes-claude.test.mjs && vitest run src/components/reglages/sections/Claude.test.tsx src/components/chat/CarteUtilisation.test.tsx src/components/chat/ContenuChoixModele.test.tsx",
    "test:catalogue-agent": "node --experimental-strip-types --import ./scripts/resoudre-ts.mjs --no-warnings scripts/test-catalogue-agent.mjs",
    "test:skills-codex": "node scripts/test-skills-codex.mjs",
    "test:consignes-projet": "vitest run src/lib/consignes-projet.test.ts && node --experimental-strip-types --test electron/consignes-projet.test.mts && node scripts/test-consignes-projet.mjs",
    "test:workflows": "vitest run src/lib/workflows && node --test serveur/workflows.test.mjs serveur/fils.test.mjs serveur/workflows-moteur.test.mjs",
    "test:workflows:app": "node scripts/test-workflows-agents.mjs",
    "test:fils-serveur": "node scripts/test-fils-serveur.mjs",
    "test:terminal": "node --experimental-strip-types --test electron/terminal.test.mts && node --test serveur/terminal.test.mjs && vitest run src/lib/terminal.test.ts",
    "test:mcp-sante": "node --experimental-strip-types --test electron/mcp-sante.test.mts && node --test serveur/mcp-sante.test.mjs && vitest run src/lib/sante-mcp.test.ts",
    "test:mcp-sante-ecran": "vitest run src/components/shell/AppRail.test.tsx",
    "test:terminal-ecran": "node scripts/test-terminal-ecran.mjs",
    "test:terminal-poste": "electron scripts/test-terminal-poste.cjs",
    "test:session-claude": "node --experimental-strip-types --test electron/session-claude.test.mts && vitest run src/lib/session-agent.test.ts",
    "test:session-serveur": "node scripts/test-session-serveur.mjs",
    "test:session-claude:app": "node scripts/test-session-claude.mjs",
    "test:fond-serveur": "node scripts/test-fond-serveur.mjs",
    "test:avis-serveur": "node scripts/test-avis-serveur.mjs",
    "test:serveur-fournisseurs": "node scripts/test-serveur-fournisseurs.mjs",
    "test:serveur-grok": "node scripts/test-serveur-grok.mjs",
    "test:equipe-serveur": "electron scripts/test-equipe-serveur.cjs",
    "test:moteurs": "node --experimental-strip-types --test electron/moteurs/registre.test.mts electron/moteurs/codex-protocole.test.mts electron/moteurs/installation.test.mts electron/moteurs/acp.test.mts electron/utilisation.test.mts",
    "test:moteur-codex": "electron scripts/test-moteur-codex.cjs",
    "test:codex-mcp": "node scripts/test-codex-mcp.mjs",
    "test:moteur-grok": "electron scripts/test-moteur-grok.cjs",
    "test:fournisseurs": "vitest run src/lib/fournisseurs.test.ts",
    "test:contexte": "vitest run src/lib/contexte.test.ts",
    "test:fond": "vitest run src/lib/fond-agents.test.ts src/lib/telephone/fond-telephone.test.tsx src/lib/copie-compte.test.ts",
    "mesure:socle": "node scripts/mesure-socle.mjs",
    "bench:jetons": "node --experimental-strip-types scripts/banc-jetons/banc.mjs",
    "test:conseil-contexte": "node scripts/test-conseil-contexte.mjs",
    "test:configuration": "node scripts/test-configuration-klyra.mjs",
    "test:resume-auto": "node scripts/test-resume-auto.mjs",
    "test:repartir-a-zero": "node scripts/test-repartir-a-zero.mjs",
    "test:fichiers": "vitest run src/lib/fichiers.test.tsx",
    "test:projet-github": "node scripts/test-projet-github.mjs",
    "test:connexion-github": "node scripts/test-connexion-github.mjs",
    "test:git": "node --experimental-strip-types --test electron/git.test.mts && vitest run src/lib/depot-projet.test.ts",
    "test:telechargement": "vitest run src/lib/telechargement.test.ts",
    "test:projets-telephone": "vitest run src/lib/telephone/dossiers.test.ts src/lib/telephone/gestes-fichiers.test.ts src/lib/telephone/ecrans.test.tsx",
    "test:identite": "vitest run src/lib/identite.test.ts",
    "test:infobulle": "vitest run src/lib/infobulle.test.ts",
    "test:atelier": "vitest run src/lib/atelier-agent.test.ts src/lib/atelier-equipe.test.ts src/lib/copie-compte.test.ts src/lib/telephone/gestes-atelier.test.ts src/lib/telephone/gestes-equipe.test.ts src/lib/telephone/atelier-telephone.test.tsx && node --experimental-strip-types --test electron/epreuve.test.mts",
    "test:atelier:app": "node scripts/test-atelier.mjs",
    "test:atelier-equipe:app": "node scripts/test-atelier-equipe.mjs",
    "test:cartes": "vitest run src/lib/cartes-interactives.test.ts src/lib/telephone/cartes-telephone.test.tsx",
    "test:collage": "vitest run src/lib/collage.test.ts",
    "test:recherche": "vitest run src/lib/recherche.test.ts",
    "test:report": "vitest run src/lib/report.test.ts",
    "test:planning-telephone": "vitest run src/lib/telephone/planning.test.ts src/lib/telephone/saisie-planning.test.ts",
    "test:modeles": "vitest run src/lib/maj-modele.test.ts src/lib/modeles-klyra.test.ts",
    "test:automatisations": "vitest run src/lib/telephone/routines-telephone.test.ts src/lib/telephone/workflow-etapes.test.ts",
    "test:app-web": "node --test scripts/sortie-vercel.test.mjs",
    "test:origine-telephone": "node --test scripts/origine-telephone.test.mjs",
    "github:preparer": "node scripts/preparer-github.mjs",
    "test:github-projets": "node --experimental-strip-types --import ./scripts/resoudre-ts.mjs --test electron/github-projets.test.mts electron/github-outils.test.mts && node --test serveur/github.test.mjs && vitest run src/lib/projet-depuis-depot.test.ts src/lib/choix-depot.test.ts src/lib/conversation-projet.test.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "0.0.96",
    "@convex-dev/presence": "^0.4.0",
    "@postshiba/convex": "0.1.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.131",
    "klyra-ui": "github:CorentinQueuche/klyra-ui#main",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.66",
    "electron": "^44.9.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.5",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "packageManager": "pnpm@11.0.4",
  "build": {
    "appId": "design.klyra.app",
    "productName": "KLYRA",
    "protocols": [
      {
        "name": "KLYRA",
        "schemes": [
          "klyra"
        ]
      }
    ],
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "asarUnpack": [
      "resources/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "sign": "scripts/signer-mac.cjs",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KLYRA utilise le micro pour la dictée, transcrite sur ce Mac.",
        "NSScreenCaptureUsageDescription": "KLYRA capture l’écran pour qu’un agent voie les fenêtres des apps que tu lui demandes de piloter.",
        "NSAppleEventsUsageDescription": "KLYRA envoie des événements d’automatisation pour qu’un agent pilote les apps que tu lui demandes."
      },
      "extraResources": [
        {
          "from": "vendor/whisper/darwin",
          "to": "whisper",
          "filter": [
            "whisper-server"
          ]
        },
        {
          "from": "vendor/cua-driver/darwin",
          "to": "cua-driver",
          "filter": [
            "cua-driver",
            "LICENSE.md"
          ]
        },
        {
          "from": "vendor/github/darwin",
          "to": "github",
          "filter": [
            "gh",
            "gh.exe",
            "LICENSE"
          ]
        }
      ]
    },
    "dmg": {
      "title": "KLYRA"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "extraResources": [
        {
          "from": "vendor/whisper/win32",
          "to": "whisper",
          "filter": [
            "*.exe",
            "*.dll"
          ]
        },
        {
          "from": "vendor/cua-driver/win32",
          "to": "cua-driver",
          "filter": [
            "cua-driver.exe",
            "LICENSE.md"
          ]
        },
        {
          "from": "vendor/github/win32",
          "to": "github",
          "filter": [
            "gh",
            "gh.exe",
            "LICENSE"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "KLYRA-${version}-win-x64-setup.exe",
      "shortcutName": "KLYRA"
    }
  }
}
