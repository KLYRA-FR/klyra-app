{
  "name": "klyra-app",
  "version": "0.1.0",
  "private": true,
  "description": "App de bureau interne KLYRA : chat avec des rôles (Principal, Dev, UX/UI, DA), projets et fichiers.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:convex": "convex dev",
    "postinstall": "node scripts/nom-app-dev.mjs",
    "desktop": "pnpm build:electron && concurrently -k -n web,app -c gray,black \"next dev -p 3100\" \"wait-on http://localhost:3100 && env -u ELECTRON_RUN_AS_NODE KLYRA_DEV_URL=http://localhost:3100 electron .\"",
    "build": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "site:dev": "next dev site -p 3200",
    "site:build": "next build site",
    "agents:equipe": "node scripts/agents-equipe.mjs",
    "start:desktop": "pnpm build && pnpm build:electron && env -u ELECTRON_RUN_AS_NODE electron .",
    "test:smoke": "pnpm build && pnpm build:electron && env -u ELECTRON_RUN_AS_NODE KLYRA_SMOKE_TEST=1 electron .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test:agents": "node scripts/test-agents.mjs",
    "test:superagent": "pnpm build:electron && node scripts/test-superagent.cjs",
    "test:composio": "node scripts/test-composio-api.cjs && node scripts/test-composio-espace.cjs && node scripts/test-composio-connect.cjs",
    "test:composio:natif": "electron scripts/test-composio-natif.cjs",
    "test:composio:runtime": "electron scripts/test-composio-runtime.cjs",
    "test:composio:interface": "electron scripts/test-composio-interface.cjs",
    "test:delegation": "node scripts/test-delegation.mjs",
    "test:maj-modeles": "node scripts/test-maj-modeles.mjs",
    "test:bibliotheque": "node scripts/test-bibliotheque.mjs",
    "test:conversation": "node scripts/test-conversation.mjs",
    "test:epinglage": "vitest run src/lib/epinglage.test.ts",
    "test:epingler": "node scripts/test-epinglage.mjs",
    "test:export-document": "vitest run src/lib/export-conversation.test.ts",
    "test:exporter": "node scripts/test-export.mjs",
    "test:apercu": "vitest run src/lib/apercu/apercu.test.ts",
    "test:lecteurs": "node scripts/test-lecteurs.cjs",
    "test:visionneuse": "node scripts/test-visionneuse.mjs",
    "test:coller": "node scripts/test-collage.mjs",
    "test:chercher": "node scripts/test-recherche.mjs",
    "test:reporter": "node scripts/test-report.mjs",
    "test:annuler": "node scripts/test-annulation.mjs",
    "test:suppression": "vitest run src/lib/suppression-rappels.test.ts",
    "test:tickets": "vitest run src/lib/tickets.test.ts",
    "test:tickets:app": "node scripts/test-tickets.mjs",
    "test:profil": "node scripts/test-profil.mjs",
    "test:liens": "node scripts/test-liens.mjs",
    "test:consommation": "electron scripts/test-consommation.cjs",
    "test:relais": "node --experimental-strip-types --test electron/ordinateur/relais.test.mts",
    "test:routines": "node scripts/test-routine-schedule.cjs && node scripts/test-routines.cjs && node scripts/test-routine-ipc.cjs && node scripts/test-routine-claude.cjs",
    "test:ordinateur": "electron scripts/test-ordinateur.cjs",
    "test:sons": "electron scripts/test-sons.cjs",
    "app": "pnpm build && pnpm build:electron && pnpm whisper && pnpm cua-driver && electron-builder --mac --publish never --config.directories.output=\"$HOME/.klyra/build\"",
    "whisper": "node scripts/preparer-whisper.mjs",
    "cua-driver": "node scripts/preparer-cua-driver.mjs",
    "test:convex": "vitest run convex",
    "test:selecteur": "node scripts/test-selecteur-serveur.mjs",
    "test:mobile": "vitest run src/lib/mobile.test.ts src/lib/poste-texte.test.ts convex/telephone.test.ts && node --test serveur/qr.test.mjs",
    "test:reglages-mobile": "node scripts/test-mobile.mjs",
    "test:telephone-agents": "vitest run src/lib/telephone",
    "test:coque": "vitest run src/lib/coque.test.ts src/lib/push.test.ts convex/notificationsPush.test.ts",
    "test:serveur": "vitest run src/lib/serveur-vps.test.ts && node scripts/serveur-genere.mjs --verifier && node --test serveur/klyra-serveur.test.mjs serveur/routines.test.mjs serveur/qr.test.mjs && node --experimental-strip-types --test electron/lien-rejoindre.test.mts electron/appel-serveur.test.mts electron/contexte-distant.test.mts electron/atelier.test.mts",
    "test:binaire": "node --experimental-strip-types --test electron/claude-binaire.test.mts electron/artefacts-liste.test.mts",
    "test:titre": "node --experimental-strip-types --test electron/titre.test.mts",
    "test:serveur-fournisseurs": "node scripts/test-serveur-fournisseurs.mjs",
    "test:moteurs": "node --experimental-strip-types --test electron/moteurs/registre.test.mts electron/moteurs/codex-protocole.test.mts electron/moteurs/installation.test.mts",
    "test:moteur-codex": "electron scripts/test-moteur-codex.cjs",
    "test:fournisseurs": "vitest run src/lib/fournisseurs.test.ts",
    "test:contexte": "vitest run src/lib/contexte.test.ts",
    "mesure:socle": "node scripts/mesure-socle.mjs",
    "bench:jetons": "node --experimental-strip-types scripts/banc-jetons/banc.mjs",
    "test:conseil-contexte": "node scripts/test-conseil-contexte.mjs",
    "test:configuration": "node scripts/test-configuration-klyra.mjs",
    "test:fichiers": "vitest run src/lib/fichiers.test.tsx",
    "test:projets-telephone": "vitest run src/lib/telephone/dossiers.test.ts src/lib/telephone/gestes-fichiers.test.ts src/lib/telephone/ecrans.test.tsx",
    "test:identite": "vitest run src/lib/identite.test.ts",
    "test:collage": "vitest run src/lib/collage.test.ts",
    "test:recherche": "vitest run src/lib/recherche.test.ts",
    "test:report": "vitest run src/lib/report.test.ts",
    "test:planning-telephone": "vitest run src/lib/telephone/planning.test.ts src/lib/telephone/saisie-planning.test.ts",
    "test:modeles": "vitest run src/lib/maj-modele.test.ts src/lib/modeles-klyra.test.ts",
    "test:automatisations": "vitest run src/lib/telephone/routines-telephone.test.ts src/lib/telephone/workflow-etapes.test.ts",
    "test:app-web": "node --test scripts/sortie-vercel.test.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "0.0.96",
    "@convex-dev/presence": "^0.4.0",
    "@postshiba/convex": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.131",
    "klyra-ui": "github:CorentinQueuche/klyra-ui#main",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.66",
    "electron": "^44.9.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.5",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "packageManager": "pnpm@11.0.4",
  "build": {
    "appId": "design.klyra.app",
    "productName": "KLYRA",
    "protocols": [
      {
        "name": "KLYRA",
        "schemes": [
          "klyra"
        ]
      }
    ],
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "asarUnpack": [
      "resources/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "sign": "scripts/signer-mac.cjs",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KLYRA utilise le micro pour la dictée, transcrite sur ce Mac.",
        "NSScreenCaptureUsageDescription": "KLYRA capture l’écran pour qu’un agent voie les fenêtres des apps que tu lui demandes de piloter.",
        "NSAppleEventsUsageDescription": "KLYRA envoie des événements d’automatisation pour qu’un agent pilote les apps que tu lui demandes."
      },
      "extraResources": [
        {
          "from": "vendor/whisper/darwin",
          "to": "whisper",
          "filter": [
            "whisper-server"
          ]
        },
        {
          "from": "vendor/cua-driver/darwin",
          "to": "cua-driver",
          "filter": [
            "cua-driver",
            "LICENSE.md"
          ]
        }
      ]
    },
    "dmg": {
      "title": "KLYRA"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "extraResources": [
        {
          "from": "vendor/whisper/win32",
          "to": "whisper",
          "filter": [
            "*.exe",
            "*.dll"
          ]
        },
        {
          "from": "vendor/cua-driver/win32",
          "to": "cua-driver",
          "filter": [
            "cua-driver.exe",
            "LICENSE.md"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "KLYRA-${version}-win-x64-setup.exe",
      "shortcutName": "KLYRA"
    }
  }
}
